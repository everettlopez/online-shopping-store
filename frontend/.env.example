# Copy to frontend/.env.production.local (or set in your build environment).
# Vite bakes these into the bundle at build time, so never put secrets here.

# The API's public address, including the /api prefix
VITE_API_URL=https://api.example.com/api

# The store's identity. Shown in the header, page title, footer and the legal and
# contact pages. All optional; without them the store is called "Online Store".
VITE_STORE_NAME=Online Store
# The wordmark at the top of every page (default: the store name in capitals)
# VITE_STORE_LOGO_TEXT=ONLINE STORE
# The page's meta description for search engines and link previews
# VITE_STORE_DESCRIPTION=Shop our latest products.
# Where customers write for help (shown on the contact and legal pages)
# VITE_SUPPORT_EMAIL=support@example.com
# The legal pages name the business behind the store (default: the store name),
# its mailing address, and the state whose laws govern the terms
# VITE_BUSINESS_NAME=Example Store LLC
# VITE_BUSINESS_ADDRESS=123 Main St, Salt Lake City, UT 84101
# VITE_BUSINESS_STATE=Utah
# Days customers have to start a return (default 30)
# VITE_RETURN_DAYS=30
# The footer links to built-in Privacy, Terms and Shipping & Returns pages, whose
# wording is a general starting point (have it reviewed). To use your own policies
# instead, link to them here
# VITE_PRIVACY_POLICY_URL=https://example.com/privacy
# VITE_TERMS_URL=https://example.com/terms
# VITE_SHIPPING_POLICY_URL=https://example.com/shipping

# The home page. The headline sits on the hero photo. Images are addresses on the
# storefront or the API's domain (the content security policy blocks other sites):
# put your own photos in frontend/public/custom/ and use /custom/<file name>
# VITE_HERO_HEADLINE=Find something you'll love.
# VITE_HERO_IMAGE_URL=/custom/hero.jpg
# A full-width photo between New Arrivals and the contact section (none by default)
# VITE_BANNER_IMAGE_URL=/custom/banner.jpg
# A page listing your events (pop-ups, markets); adds an Events link and button
# VITE_EVENTS_URL=https://example.com/events

# The browser-tab icon (default: a shopping bag, /favicon.svg). Put yours in
# frontend/public/custom/: an SVG, or a square PNG of at least 64x64
# VITE_FAVICON_URL=/custom/favicon.png
# Link previews (when someone shares the store on social media or in a message) show
# the store name, the description above and this image, 1200x630 works best
# (default: the hero photo; none if neither is set)
# VITE_SHARE_IMAGE_URL=/custom/share.jpg
# The storefront's own address, which link previews need for the image. The deploy
# kit sets it from STORE_DOMAIN
# VITE_SITE_URL=https://shop.example.com
