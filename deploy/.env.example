# Copy to deploy/.env (never commit it). Read by deploy/docker-compose.yml.
# The API's own secrets and settings go in deploy/.env.api, copied from the root .env.example.

# Your domains. Point DNS A records for both (and www.<STORE_DOMAIN>) at the server first,
# so Caddy can get HTTPS certificates
STORE_DOMAIN=shop.example.com
API_DOMAIN=api.shop.example.com
# Let's Encrypt emails this address about problems with the certificates
ACME_EMAIL=you@example.com

# Start with Report-Only: browsers report policy violations in the console but load
# everything. Change to Content-Security-Policy once the console stays clean
CSP_HEADER=Content-Security-Policy-Report-Only

# Only if Cloudflare's proxy (orange cloud) sits in front of the server: Cloudflare's
# IP ranges from https://www.cloudflare.com/ips/, separated by spaces, so the API
# sees visitors' real addresses. Leave unset otherwise; trusting other addresses
# would let visitors fake theirs and dodge the rate limits
# TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22 ...

# The storefront's identity, baked in at build time (see frontend/.env.example).
# Rebuild after changing any of them: docker compose -f deploy/docker-compose.yml up -d --build
VITE_STORE_NAME=Online Store
# VITE_STORE_LOGO_TEXT=ONLINE STORE
# VITE_STORE_DESCRIPTION=Shop our latest products.
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_BUSINESS_NAME=Example Store LLC
# VITE_BUSINESS_ADDRESS=123 Main St, Springfield, IL 62701
# VITE_BUSINESS_STATE=Illinois
# VITE_RETURN_DAYS=30
# VITE_PRIVACY_POLICY_URL=
# VITE_TERMS_URL=
# VITE_SHIPPING_POLICY_URL=
# The home page (see frontend/.env.example); custom photos go in frontend/public/custom/
# VITE_HERO_HEADLINE=Find something you'll love.
# VITE_HERO_IMAGE_URL=/custom/hero.jpg
# VITE_BANNER_IMAGE_URL=/custom/banner.jpg
# VITE_EVENTS_URL=
# The browser-tab icon, and the image shown when someone shares a link to the store
# (default: the hero photo); see frontend/.env.example
# VITE_FAVICON_URL=/custom/favicon.png
# VITE_SHARE_IMAGE_URL=/custom/share.jpg

# Backups made by deploy/backup.sh (docs/hosting.md, "Backups"), all optional:
# where the files go on this server (default deploy/backups), how many days of them
# to keep here, and an rclone destination that gets a copy of each (set up with
# `rclone config` first; give the bucket a lifecycle rule to expire old copies)
# BACKUP_DIR=/var/backups/online-store
# BACKUP_KEEP_DAYS=14
# BACKUP_REMOTE=b2:my-store-backups/store

# Only with --profile mysql (MySQL on this server instead of a managed database).
# Use long random values; DATABASE_URL in deploy/.env.api must use MYSQL_PASSWORD
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
