# Copy to deploy/.env (never commit it). Read by deploy/docker-compose.yml.
# The API's own secrets and settings go in deploy/.env.api, copied from the root .env.example.

# Your domains. Point DNS A records for both (and www.<STORE_DOMAIN>) at the server first,
# so Caddy can get HTTPS certificates
STORE_DOMAIN=shop.example.com
API_DOMAIN=api.shop.example.com
# Let's Encrypt emails this address about problems with the certificates
ACME_EMAIL=you@example.com

# Start with Report-Only: browsers report policy violations in the console but load
# everything. Change to Content-Security-Policy once the console stays clean
CSP_HEADER=Content-Security-Policy-Report-Only

# The storefront's identity, baked in at build time (see frontend/.env.example).
# Rebuild after changing any of them: docker compose -f deploy/docker-compose.yml up -d --build
VITE_STORE_NAME=Online Store
# VITE_STORE_LOGO_TEXT=ONLINE STORE
# VITE_STORE_DESCRIPTION=Shop our latest products.
# VITE_SUPPORT_EMAIL=support@example.com
# VITE_BUSINESS_NAME=Example Store LLC
# VITE_BUSINESS_ADDRESS=123 Main St, Springfield, IL 62701
# VITE_BUSINESS_STATE=Illinois
# VITE_RETURN_DAYS=30
# VITE_PRIVACY_POLICY_URL=
# VITE_TERMS_URL=
# VITE_SHIPPING_POLICY_URL=

# Only with --profile mysql (MySQL on this server instead of a managed database).
# Use long random values; DATABASE_URL in deploy/.env.api must use MYSQL_PASSWORD
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=
