# Caddy serves both sites over HTTPS, getting and renewing certificates by itself.
# STORE_DOMAIN, API_DOMAIN, ACME_EMAIL, CSP_HEADER and TRUSTED_PROXIES come from deploy/.env
# (passed in by deploy/docker-compose.yml).
{
	# Let's Encrypt writes here about problems with the certificates
	email {$ACME_EMAIL}

	servers {
		# Proxies in front of Caddy whose word on the visitor's address we take.
		# None by default (127.0.0.1 is Caddy itself). Behind Cloudflare's proxy,
		# set TRUSTED_PROXIES in deploy/.env to Cloudflare's IP ranges; the visitor's
		# address then comes from Cloudflare's CF-Connecting-IP header.
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers CF-Connecting-IP
	}
}

(security_headers) {
	header {
		# Browsers use only HTTPS for this site for a year
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No other site may show these pages in a frame (clickjacking)
		X-Frame-Options "DENY"
		# Browser features the store never uses stay off, even for a script that sneaks in
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

{$STORE_DOMAIN} {
	import security_headers
	# Which sources the storefront may load from. CSP_HEADER starts as
	# Content-Security-Policy-Report-Only, so violations only show in the browser
	# console; once the console is clean, set it to Content-Security-Policy in
	# deploy/.env to enforce it. Browsers also send each violation to the API's
	# /api/csp-report, which logs it ("csp violation" in the API's logs), so you can
	# see what enforcing would block before you do. MUI adds inline styles, hence
	# 'unsafe-inline' for styles.
	header {$CSP_HEADER:Content-Security-Policy-Report-Only} "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://{$API_DOMAIN}; connect-src 'self' https://{$API_DOMAIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri https://{$API_DOMAIN}/api/csp-report"
	encode zstd gzip
	reverse_proxy web:8080
}

www.{$STORE_DOMAIN} {
	redir https://{$STORE_DOMAIN}{uri} permanent
}

{$API_DOMAIN} {
	import security_headers
	# Product forms carry up to several 5 MB images; refuse anything far bigger
	request_body {
		max_size 30MB
	}
	encode zstd gzip
	reverse_proxy api:8000 {
		# Send the API only the visitor's address (from a trusted proxy, or the
		# connection itself), never a list a visitor could have started with a fake
		# entry. The API's rate limits count this address.
		header_up X-Forwarded-For {client_ip}
	}
}
