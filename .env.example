# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/online_store
# At least 32 random characters; the API refuses to start with a shorter one
JWT_SECRET_KEY=change-me
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Your store's name as customers see it in emails (default: Online Store). The
# storefront's name is set separately at build time (VITE_STORE_NAME in frontend/.env.example)
STORE_NAME=Online Store

# Optional deployment settings (defaults shown suit local development)
# Where Stripe sends customers back to after checkout
FRONTEND_URL=http://localhost:5173
# The API's public address, used in uploaded image links (defaults to the address
# of the incoming request, which is wrong behind a reverse proxy)
# PUBLIC_API_URL=https://api.example.com
# Where product images are saved (defaults to app/uploads). In production, point
# this at a persistent volume; most hosts wipe the app's own folder on every deploy
# UPLOAD_DIR=/data/uploads
# Comma-separated sites allowed to call the API with the login cookie
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use lax when the frontend and API share a site in production
COOKIE_SAMESITE=none
COOKIE_SECURE=true
# Set to false in production to hide /docs and /openapi.json
ENABLE_DOCS=true
# Set to true to log every SQL statement (local debugging only)
SQL_ECHO=false

# Requests per minute each visitor (IP address) may make; 0 turns a limit off.
# AUTH: login, register, forgot/reset password. LOOKUP: finding an order without an
# account. CHECKOUT: starting Stripe Checkout. Each API worker counts separately.
AUTH_RATE_LIMIT_PER_MINUTE=10
LOOKUP_RATE_LIMIT_PER_MINUTE=20
CHECKOUT_RATE_LIMIT_PER_MINUTE=20

# Shipping and sales tax (defaults shown)
# Flat shipping per order, free once the items total FREE_SHIPPING_THRESHOLD or more
SHIPPING_FLAT_RATE=6.95
FREE_SHIPPING_THRESHOLD=75
# Stripe Tax adds sales tax at checkout. It needs Stripe Tax set up in the Dashboard
# (business address and registrations); set false only for local development before that
STRIPE_AUTOMATIC_TAX=true
# Stripe tax code for the products (txcd_30011000 = General - Clothing)
STRIPE_PRODUCT_TAX_CODE=txcd_30011000

# Email (password reset, order confirmation, shipping notice), sent through Resend
# Without a key, emails are printed in the API's terminal instead (fine locally;
# production must set one)
# RESEND_API_KEY=re_xxx
# Default sender. onboarding@resend.dev only delivers to your own Resend account's email;
# in production use an address on a domain verified in Resend
EMAIL_FROM=Online Store <onboarding@resend.dev>
# Optional senders per kind of email (each falls back to EMAIL_FROM)
# ORDERS_EMAIL_FROM="Your Store <orders@example.com>"     # order confirmations, shipping notices
# ACCOUNT_EMAIL_FROM="Your Store <support@example.com>"   # password reset
# Where customers' replies go, whichever address sent the email (unset: the sender)
# EMAIL_REPLY_TO=support@example.com
# How long a password reset link works
PASSWORD_RESET_MINUTES=30
